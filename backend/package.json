{
  "name": "pandiyanagency",
  "version": "1.0.0",
  "description": "Pandiyan Agency device management API",
  "main": "src/server.js",
  "author": "nutz",
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "start:prod": "node src/server.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "deploy": "NODE_ENV=production pm2 start src/server.js --name \"Pandiyan Agency (3034)\" --max-memory-restart 2500M"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.3",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nutzdev/pandiyan_agency_flutter_backend.git"
  },
  "bugs": {
    "url": "https://github.com/nutzdev/pandiyan_agency_flutter_backend/issues"
  },
  "homepage": "https://api.pandiyanagency.com"
}
