PORT=3034
NODE_ENV=production

API_PUBLIC_URL=https://api.pandiyanagency.com
ADMIN_ORIGIN=https://admin.pandiyanagency.com

DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_db_password
DB_NAME=api

# Required for admin panel login tokens (min 32 chars)
JWT_SECRET=
jwtadminSecret=
JWT_EXPIRE=24h

# Optional host-panel fields (not used by this API)
passwordSecret=
jwtMemberSecret=
jwtSuperAdminSecret=
jwtEmailSecret=

LOG_FILE=logs/server.log
SYNC_TIMEOUT_SECONDS=300
INACTIVE_SECONDS=900
